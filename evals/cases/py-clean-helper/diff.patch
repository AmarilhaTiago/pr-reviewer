+def truncate(text: str, limit: int) -> str:
+    """Shorten ``text`` to at most ``limit`` characters, adding an ellipsis."""
+    if limit < 1:
+        raise ValueError("limit must be positive")
+    if len(text) <= limit:
+        return text
+    return text[: limit - 1] + "…"
