# Provider used by `reviewer review`, `reviewer pr` and `reviewer evals`
# gemini | groq | openai-compatible
LLM_PROVIDER=gemini
# Exact model id from the provider's model list
LLM_MODEL=
LLM_API_KEY=

# Only for `--provider groq` (or any provider other than LLM_PROVIDER): <PROVIDER>_API_KEY
GROQ_API_KEY=

# Optional tuning (defaults shown). Free tiers have per-minute token limits:
# for Groq's 8K tokens/minute use CALL_INTERVAL_SECONDS=10 and MAX_TOKENS_PER_CHUNK=3000.
# MAX_TOKENS_PER_CHUNK=6000
# MAX_TOKENS_PER_PR=60000
# MIN_CONFIDENCE=0.5
# CALL_INTERVAL_SECONDS=2
# IGNORE_GLOBS=
# LLM_BASE_URL=
